<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Needed so getLaunchIntentForPackage()/queryIntentActivities() can see launcher apps on Android 11+.
       We only ask for launcher activities, not QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!--
      Jarvis accessibility service. The user must enable it manually in
      Settings > Accessibility > Installed apps > Jarvis. Only the system can bind to it
      (BIND_ACCESSIBILITY_SERVICE), so other apps cannot drive it.
    -->
    <service
      android:name="expo.modules.jarvisagent.JarvisAccessibilityService"
      android:exported="true"
      android:label="@string/jarvis_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/jarvis_accessibility_config" />
    </service>
  </application>
</manifest>
